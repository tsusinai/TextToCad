# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://tsusinai.github.io,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Use persistent storage when running in a container.
ARTIFACT_ROOT=./artifacts

# Optional shared secret for public /v1 routes. Leave empty for local-only use.
BACKEND_API_KEY=

LLM_API_KEY=
OPENAI_API_KEY=
# DeepSeek example; override both values for another OpenAI-compatible provider.
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-chat
# For a Flash-compatible gateway, replace the model name with the exact model identifier it exposes.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RESPONSE_BYTES=65536
MAX_CONCURRENT_JOBS=2
MAX_PENDING_JOBS=8
RATE_LIMIT_WINDOW_SECONDS=60
MAX_MUTATIONS_PER_WINDOW=30

# --- Local Gemini Code Assist reverse proxy (optional LLM provider) ---
# Run `backend/.venv/Scripts/python.exe backend/gemini_proxy.py` (port 8799),
# it bridges OpenAI-style chat completions onto the local Antigravity OAuth
# credentials (~/.gemini/oauth_creds.json) via the system proxy.
# LLM_API_URL=http://127.0.0.1:8799/v1/chat/completions
# LLM_API_KEY=local-gemini-proxy
# LLM_MODEL=gemini-2.5-flash-lite
# GEMINI_CLIENT_ID=
# GEMINI_CLIENT_SECRET=
# GEMINI_PROXY_PORT=8799
# GEMINI_PROXY_MODEL=models/gemini-2.5-flash-lite
# GEMINI_PROXY_HTTP=http://127.0.0.1:12450   # system proxy; "none" to disable
# GEMINI_PROXY_RETRY_DELAYS=5,15,30           # 429 backoff seconds
